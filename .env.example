# ── Agent ────────────────────────────────────────────────────────────────
# Providers for the main chat model — OpenRouter, FairRouter, two local
# runtimes (Ollama, llama.cpp), and the OpenAI Codex CLI (its own block
# further down). Pick whichever you have set up (or several) from the in-app
# provider/model selector (top of the chat pane); it shows each provider's
# live catalog, rather than baking in a slug that goes stale. PROVIDER and the
# matching *_MODEL below are written by the selector, not meant to be hand-edited.
PROVIDER=

# Get a key at https://openrouter.ai/keys, then restart the app.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# A FairRouter API key (Bearer token) — get one from https://fairrouter.ai,
# then restart the app.
FAIRROUTER_API_KEY=
FAIRROUTER_MODEL=

# Local Ollama — no key needed for a plain local install. Base URL defaults
# to Ollama's own OpenAI-compatible endpoint if left blank; only set it if
# Ollama is running elsewhere (a different port, another machine on the LAN).
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=

# Local llama.cpp server (llama-server) — same shape as Ollama above. Base
# URL defaults to the usual llama-server port if left blank.
LLAMACPP_BASE_URL=
LLAMACPP_API_KEY=
LLAMACPP_MODEL=

# OpenAI Codex CLI as a provider. It runs its own sandboxed agent loop as a
# subprocess — Forge shells out to `codex exec --json`. Authenticate by running
# `codex login` in a terminal (uses your ChatGPT/Codex subscription). Do NOT set
# CODEX_API_KEY / OPENAI_API_KEY — that silently switches Codex to pay-per-token
# API billing; Forge strips both from the subprocess environment for this reason.
# Codex writes to the workspace at every autonomy level (its edits go straight
# to disk, outside the diff-review queue — codex exec is non-interactive). Set
# File edits -> Always deny in Settings > Permissions to force it read-only.
# CODEX_BIN is optional — leave it blank to auto-detect `codex` on PATH (or the
# default install location).
# CODEX_MODEL is normally left as "default" (Codex picks the model — a ChatGPT
# login rejects explicit model slugs); set a real slug only on an API-key setup.
CODEX_BIN=
CODEX_MODEL=

# ── Media generation (all via OpenRouter — one key covers all of these) ────
# Image generation (generate_image tool), via OpenRouter's /images endpoint.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# Vision / image understanding (analyze_image tool).
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Music generation (generate_music tool): full song (vocals, verse/chorus/bridge)
# vs a short instrumental clip/loop.
OPENROUTER_MUSIC_MODEL=google/lyria-3-pro-preview
OPENROUTER_MUSIC_CLIP_MODEL=google/lyria-3-clip-preview

# Max tool calls (file reads, edits, commands, searches...) the agent may
# make in a single task before it stops itself. Also editable from the
# in-app Settings page. Leave blank for the default (24); max 1000.
MAX_TOOL_CALLS=

# ── Web search ───────────────────────────────────────────────────────────
# A Tavily API key. Get one at https://app.tavily.com, then restart the app.
SEARCH_API=

# ── Voice input ──────────────────────────────────────────────────────────
# Any OpenAI-compatible /audio/transcriptions endpoint.
# Groq (default below) is fast and has a free tier: https://console.groq.com/keys
# For OpenAI instead, use:
#   TRANSCRIBE_BASE_URL=https://api.openai.com/v1
#   TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=whisper-large-v3

# ── Voice output ─────────────────────────────────────────────────────────
# Also editable from the in-app Settings page (Voice output section).
# TTS_PROVIDER is one of: edge, sapi, xtts.
#   edge — Microsoft Edge's free neural voices. No key, no setup.
#   sapi — Windows' built-in offline voices (Windows only).
#   xtts — a local XTTS/Coqui server for custom cloned voices. Point
#     TTS_XTTS_SERVER_URL at one, e.g. daswer123/xtts-api-server
#     (https://github.com/daswer123/xtts-api-server), and drop reference
#     .wav clips into forge/voices/ — each one becomes a selectable voice.
TTS_PROVIDER=edge
TTS_EDGE_VOICE=en-US-AndrewNeural
TTS_SAPI_VOICE=
TTS_XTTS_SERVER_URL=http://localhost:8020
TTS_XTTS_VOICE=

# ── Phone portal ─────────────────────────────────────────────────────────
# Voice in/out on the phone page uses the browser's own SpeechRecognition/
# speechSynthesis APIs — no key or server round trip needed for either.
# The local port the phone-friendly chat page (mirroring your first
# workspace) is served on, plus the ephemeral Cloudflare quick-tunnel URL
# that exposes it. No login by design — the URL itself is the only "key".
# PORTAL_PORT=5333

# ── Operator rules ───────────────────────────────────────────────────────
# The agent's standing rules live in a single file, RULES.md, in Forge's
# user-data folder — read into every session, appended to only when you tell
# the agent to "make that a rule". Edit that file by hand any time. There is
# nothing to configure here.
