# ── Agent ────────────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys, then restart the app.
OPENROUTER_API_KEY=
# Any OpenRouter model slug that supports tool calling. Leave blank and pick
# one from the in-app model selector (top of the chat pane) instead — it
# shows OpenRouter's live catalog with pricing and context length, rather
# than baking in a slug that goes stale.
OPENROUTER_MODEL=

# ── Media generation (all via OpenRouter — one key covers all of these) ────
# Image generation (generate_image tool), via OpenRouter's /images endpoint.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# Vision / image understanding (analyze_image tool).
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Music generation (generate_music tool): full song (vocals, verse/chorus/bridge)
# vs a short instrumental clip/loop.
OPENROUTER_MUSIC_MODEL=google/lyria-3-pro-preview
OPENROUTER_MUSIC_CLIP_MODEL=google/lyria-3-clip-preview

# ── Web search ───────────────────────────────────────────────────────────
# A Tavily API key. Get one at https://app.tavily.com, then restart the app.
SEARCH_API=

# ── Voice input ──────────────────────────────────────────────────────────
# Any OpenAI-compatible /audio/transcriptions endpoint.
# Groq (default below) is fast and has a free tier: https://console.groq.com/keys
# For OpenAI instead, use:
#   TRANSCRIBE_BASE_URL=https://api.openai.com/v1
#   TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=whisper-large-v3

# ── Operator ruleset ─────────────────────────────────────────────────────
# The ruleset ships in this project at forge/rules/ and is used automatically.
# Uncomment only to point at a DIFFERENT ruleset; a missing path falls back
# to the bundled one.
# RULES_DIR=C:/path/to/other/rules
